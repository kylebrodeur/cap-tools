# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets / local env ───────────────────────────────────────────────────────
.env
.env.*
*.local
secrets.json

# ── Claude Code local state (machine-specific) ────────────────────────────────
**/.claude/settings.local.json

# ── Generated spike artifacts (large; may embed client screen content) ────────
spike/spike-output/

# ── Project working data (large media + potentially sensitive client content) ─
# Keep project structure/metadata (context.json, build.py, sessions), exclude media.
projects/*/recordings/
projects/*/frames/
projects/*/output/
projects/*/transcripts/

# ── Misc media that shouldn't live in git ─────────────────────────────────────
*.mp4
*.mov
*.mkv
*.ogg
*.mp3
*.wav

# ── Reference clones (e.g. Cap source pulled for format study) ────────────────
cap-src/

# ── Cap recordings — NEVER commit (they embed client screen content) ──────────
*.cap
*.cap/
**/*.cap/
recordings/
**/recordings/
